; Archivo de proyecto de Godot 4.
config_version=5

[application]
config/name="La Vuelta al Plato"
config/icon="res://icons/icon_512.png"
boot_splash/bg_color=Color(0.169, 0.141, 0.125, 1)
boot_splash/show_image=true
boot_splash/image="res://icons/icon_512.png"
boot_splash/fullsize=false
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")

[display]
window/handheld/orientation=4
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=2
